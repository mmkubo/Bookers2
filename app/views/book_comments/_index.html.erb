
<div id="comment-index">
<table class="table comment-table" style="width: auto;">
            <% book_detail.book_comments.each do |comment| %>
            <tr>
            <td>
              <%= image_tag comment.user.get_profile_image, size: "70x70" %><br>
              <%= link_to user_path(comment.user) do %>
                <%= comment.user.name %>
              <% end %>
            </td>
      
            <td>
              <%= comment.comment %>
            </td>
      
            <td>
              <% if comment.user == Current.user %>
                <%= link_to "Destroy", book_book_comment_path(book_detail, comment), data: {turbo_method: :delete }, class: "btn btn-danger btn-sm" %>
              <% end %>
            </td>
            </tr>
            <% end %>
          </table>

          
</div>


