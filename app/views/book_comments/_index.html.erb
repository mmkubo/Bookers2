<table class="table comment-table" style="width: auto;">
  <% book.book_comments.each do |book_comment| %>
    <tr>
      <td><%= image_tag book_comment.user.get_profile_image(70,70) %><br>
          <%= link_to user_path(book_comment.user) do %>
            <%= book_comment.user.name %>
          <% end %>
      </td>
      <td><%= book_comment.comment %></td>
      <td><% if book_comment.user == Current.user %>
            <%= link_to "Destroy", book_book_comment_path(book, book_comment), data: {turbo_method: :delete }, class: "btn btn-danger btn-sm" %>
          <% end %>
      </td>
    </tr>
  <% end %>
</table>



