
      <h2>User info</h2>
        <table class="table user_info_table">
          <tr>
          <%= image_tag user.get_profile_image, size: "100x100", class: "border" %>
          </tr>
          <tr>
            <th>name</th>
            <td class="fw-bold"><%= user.name %></td>
          </tr>
          <tr>
            <th>introduction</th>
            <td class="fw-bold"><%= user.introduction %></td>
          </tr>
          <tr>
            <th>follows</th>
            <td></td>
        </table>

      <div class="d-grid mt-4">
        <%= link_to edit_user_path(user), class: " btn btn-outline-secondary " do %>
        <i class="fa-solid fa-user-gear"></i>
        <% end %>
      </div>

      <div class="mt-3">
      <h2>New book</h2>

      <%= form_with model:book do |f| %>
 
        <div class="field">
        <%= f.label :title %><br>
        <%= f.text_field :title, class: "form-control" %>
        </div>

        <div class="field mt-3">
        <%= f.label :body, "Opinion" %><br>
        <%= f.text_area :body, class: "form-control" %>
        </div><br>

        <%= f.submit "Create Book", class: "btn", style: "background-color: #f9bc60; color: #001e1d " %>
      <% end %>
      
      </div>

