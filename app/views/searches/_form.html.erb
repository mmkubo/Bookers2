<div class="container">
  <div class="row w-100 justify-content-end">
    <div class="col-12">

    #<% if authenticated? %>
    <%= form_with url: search_path, method: :get do |f| %>
      <div class="d-flex justify-content-end"> 
        <%= f.text_field :word, class: "form-control-sm mr-5" %>
        <%= f.select :target, options_for_select([["User","User"],["Book","Book"]]), {}, class: "form-control-sm mr-5" %>
        <%= f.select :search, options_for_select([["完全一致","perfect"],["前方一致","forward"],["後方一致","backward"],["部分一致","partial"]]), {}, class: "form-control-sm mr-5" %>
      <div class="input-group-append">
        <%= f.submit "検索" %>
      </div>
      </div>
    <% end %>

      </div>
    </div>
  </div>