<div class="container px-5 mt-3">
<div class="row">
<div class="col-12 px-5 px-sm-0 mx-auto">

<% if @target == "User" %> <%# 検索条件がUserの時 %>
<h1>Users search for "<%= @word %>"</h1>

  <table class="table">

    <tr>
      <th></th>
      <th>Name</th>
      <th></th>
      <th></th>
    </tr>

      <% @users.each do |user| %>
      <tr>
        <td><%= image_tag user.get_profile_image, size: "50x50", class: "border" %></td>
        <td><%= link_to user.name, user_path(user) %></td>
        <td>フォロー数: <%= user.followings.count %></td>
        <td>フォロワー: <%= user.followers.count %></td>
      </tr>
      <% end %>
  </table>
<% end %>

<% if @target == "Book" %> <%# 検索条件がBookの時 %>
<h1>Books search for "<%= @word %>"</h1>

  <table class="table">

    <tr>
      <th></th>
      <th>Title</th>
      <th>Opinion</th>
    </tr>

      <% @books.each do |book| %>
      <tr>
        <td><%= image_tag book.user.get_profile_image, size: "50x50", class: "border" %></td>
        <td><%= link_to book.title, book_path(book) %></td>
        <td><%= book.body %></td>
      </tr>
      <% end %>
  </table>
<% end %>

</div>
</div>
</div>