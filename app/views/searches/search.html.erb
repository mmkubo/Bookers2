<div class="container px-5 mt-3">
  <div class="row">
    <div class="col-12 px-5 px-sm-0 mx-auto">

      <% if @target == "User" %> 
        <h1>Users search for "<%= @word %>"</h1>
        <%= render 'users/index', users: @users %>
      <% elsif @target == "Book" %> 
        <h1>Books search for "<%= @word %>"</h1>
        <%= render 'books/index', books: @books %>
      <% end %>

    </div>
  </div>
</div>
