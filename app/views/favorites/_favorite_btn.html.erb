<% if book.favorited_by?(Current.user) %>
  <%= link_to book_favorites_path(book), data: { turbo_method: :delete, turbo_stream: true },style: "color: #e16162;" do %>
  ♥<%= book.favorites.count %>
  <% end %>
<% else %>
  <%= link_to book_favorites_path(book), data: { turbo_method: :post, turbo_stream: true },style: "color: #90b4ce" do %>
  ♥<%= book.favorites.count %>
  <% end %>
<% end %>



