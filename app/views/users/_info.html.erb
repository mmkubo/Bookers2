<table class='table user_info_table'>
  <tr><%= image_tag user.get_profile_image(150,150), class: 'border' %></tr>
  <tr>
    <th>name</th>
    <th><%= user.name %></th>
  </tr>
  <tr>
    <th>introduction</th>
    <th><%= user.introduction %></th>
  </tr>
  <tr>
    <th>follows</th>
    <th><%= link_to user.followings.count, following_user_path(user) %></th>
  </tr>
  <tr>
    <th>followers</th>
    <th><%= link_to user.followers.count, followers_user_path(user) %></th>
  </tr>
</table>

<div class="d-grid mt-4">
  <% if user == Current.user %>
    <%= link_to edit_user_path(user), class: " btn btn-outline-secondary " do %>
      <i class="fa-solid fa-user-gear"></i>
    <% end %>
  <% else %>
    <%= render 'relationships/btn', user: user %>
    <% if Current.user.mutual_following?(user) %>
     <%= link_to "チャットを始める", rooms_path(other_id: user.id), data: { turbo_method: :post } %>
    <% end %>
  <% end %>
</div>

