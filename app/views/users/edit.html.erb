<div class="container px-5 mt-3">
<div class="row">
<div class="col-sm-12 col-md-10 col-lg-5 px-5 px-sm-0 mx-auto">

<h2>User info</h2>

<% if @user.errors.any? %>
  <div id="error_explanation">
    <h3><%= pluralize(@user.errors.count, "error") %> prohibited this book from being saved:</h3>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

  <%= form_with model:@user do |f| %>
  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name, autofocus: true, class: "form-control" %>
  </div>

  <div class="field mt-3">
    <%= f.label :profile_image, "Image" %><br>
    <%= f.file_field :profile_image, accept: "image/*" %>
  </div>

  <div class="field mt-3">
    <%= f.label :introduction %><br>
    <%= f.text_area :introduction, autofocus: true, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= f.submit "Update User", class:"btn btn-secondary" %>
  </div>
  
  <% end %>

</div>
</div>
</div>
