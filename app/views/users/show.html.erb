<div class="container mt-3 px-5">
    <div class="row mx-3">

      <div class="col-3 ">
        <%= render "layouts/sidebar", user: @user, book: @book %>
      </div>

      <div class="col-8 offset-1">
        <h2>Books</h2>
          <table class="table table-hover">
          <thead>
            <tr>
              <th></th>
              <th>Title</th>
              <th>Opinion</th>
            </tr>
          </thead>
          <tbody>
            <% @books.each do |book| %>
              <tr>
                <td>
                <%= link_to user_path(book.user) do %>
                  <%= image_tag @user.get_profile_image, size: "80x80", class: "border"%>
                <% end %>
                </td>
                <td>
                  <%= link_to book.title, book_path(book) %>
                </td>
                <td><%= book.body %></td>
              </tr>
            <% end %>
          </tbody>
          </table>
      </div>

  </div>  <%# row %>
</div>  <%# container %>
