<div class="container px-5 mt-3">
  <div class="row">

    <div class="col-md-3">
      <h2>User info</h2>
      <%= render "info", user: Current.user %>
      <div class="mt-3">
        <h2>New book</h2>
      </div>
      <%= render 'books/form', book: @book %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Users</h2>
      <%= render 'index', users: @users %>
    </div>

  </div>
</div>
