<div class="container-fluid mt-3">
<div class="row">
<div class="col-md-8 offset-md-2">

<h2>Sign up</h2>

<%= form_with model: @user,ulr: users_path do |f| %>
  <% if @user.errors.any? %>
    <div class="error_explanation">
      <h2><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved: </h2>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name, autofocus: true %>
  </div>

  <div class="field">
    <%= f.label :email_address, "Email" %><br>
    <%= f.text_field :email_address %>
  </div>

  <div class="field">
    <%= f.label :password, "Password (6 characters minimum)" %><br>
    <%= f.password_field :password %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation %><br>
    <%= f.password_field :password_confirmation %>
  </div>

  <div class="actions">
    <%= f.submit "Sign up", class: "btn btn-sm", style: "background-color: #f9bc60; color: #001e1d; border" %>
  </div>
<% end %>

<%= link_to "Log in", new_session_path %>

</div>
</div>
</div>

