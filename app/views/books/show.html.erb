<div class="container px-5 mt-3">
    <div class="row">

  <% if @book_comment && @book_comment.errors.any? %>
    <div id="error_explanation">
      <h3><%= pluralize(@book_comment.errors.count, "error") %> prohibited this comment from being saved:</h3>
      <ul>
        <% @book_comment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
     </div>
  <% end %>

      <div class="col-md-3">
        <%= render "layouts/sidebar", user: @user, book: @book %>
      </div>

      <div class="col-md-8 offset-md-1">
        <h2>Book detail</h2>
          <table class="table">
            <tbody>
            <tr>

              <td>
                <%= image_tag @user.get_profile_image, size: "100x100", class: "border"%><br>
                <%= link_to user_path(@book_detail.user) do %>
                  <%= @book_detail.user.name %>
                <% end %>
              </td>

              <td>
                <%= link_to book_path(@book_detail) do %>
                  <%= @book_detail.title %>
                <% end %>
              </td>

              <td><%= @book_detail.body %></td>

              <% if @book_detail.user == Current.user %>
              <td>
                <%= link_to "Edit", edit_book_path(@book_detail), class:"btn btn-success btn-sm" %>
              </td>
              <td>
                <%= link_to "Destroy", book_path(@book_detail),data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" }, class: "btn btn-danger btn-sm" %>
              </td>
              <% end %>
              <td>
                <%= turbo_frame_tag dom_id(@book_detail, :favorite) do %>
                  <%= render "favorites/favorite_btn", book: @book_detail %>
                <% end %>
              </td>
              <td>
                コメント数: <%= @book_detail.book_comments.count %>
              </td>
              </tr>
            </tbody>
          </table>

          <div id="comment-index">
            <%= render "book_comments/index", book_detail: @book_detail %>
          </div>

      </div> <%# col-md-8 offset-md-2 %>

  </div>  <%# row %>
</div>  <%# container %>
