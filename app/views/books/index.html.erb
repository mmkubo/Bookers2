<div class="container mt-3 px-5">
    <div class="row mx-3">

      <div class="col-3">
        <%= render "layouts/sidebar", user: @user, book: @book %>
      </div>

      <div class="col-8 offset-1">
        <h2>Books</h2>
          <table class="table">
            <tr>
              <th style="width: 10%;"></th>
              <th style="width: 30%;">Title</th>
              <th style="width: 60%;">Opinion</th>
            </tr>
            <% @books.each do |book| %>
            <tr>
              <td class=""><%= image_tag book.user.get_profile_image, size: "85x85", class: "border"%></td>
              <td><%= link_to book_path(book) do %>
                <%= book.title %>
              <% end %>
              <td><%= book.body %></td>
            </tr>
            <% end %>
          </table>
      </div>

    </div>  <%# row %>
    </div>  <%# col-8 offset-2 %>
  </div>  <%# row %>
</div>  <%# container %>
