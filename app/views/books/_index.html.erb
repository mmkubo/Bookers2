<table class="table table-hover">
  <thead>
    <tr>
      <th></th>
      <th>Title</th>
      <th>Opinion</th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% books.each do |book| %>
      <tr>
        <td>
          <%= link_to (book.user) do %>
            <%= image_tag book.user.get_profile_image(85,85), class: "border" %>
          <% end %>
        </td>
        <td><%= link_to book.title, book %></td>
        <td><%= book.body %></td>
        <td>
          <%= turbo_frame_tag dom_id(book, :favorite) do %>
            <%= render "favorites/favorite_btn", book: book %>
          <% end %>
        </td>
        <td><%= render "book_comments/counter", book: book %></td>
      </tr>
    <% end %>
  </tbody>
</table>