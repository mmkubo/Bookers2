<div class="container px-5 mt-3">
  <div class="row">
    <div class="col-sm-12 col-md-10 col-lg-5 px-5 px-sm-0 mx-auto">

      <h1>Editing Book</h1>
        <%= form_with model:@book do |f| %>
          <%= render 'layouts/error', obj: f.object %>
          <div class="field">
            <%= f.label :title %><br>
            <%= f.text_field :title, class: "form-control" %>
          </div>
          <div class="field mt-3">
            <%= f.label :body, "Opinion" %><br>
            <%= f.text_area :body, class: "form-control " %>
          </div>
          <%= f.submit "Update Book", class: "btn btn-success mt-3" %>
        <% end %>
      <div class="mt-3">
        <%= link_to "Show", @book %> | <%= link_to "Back", books_path %>
      </div>

    </div>
  </div>
</div>

