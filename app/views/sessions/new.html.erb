<div class="container-fluid mt-3">
<div class="row">
<div class="col-md-8 offset-md-2">

<h2>Log in</h2>

<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<%= form_with url: session_path do |f| %>
  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name, required: true, autofocus: true, autocomplete: "username", value: params[:name] %>
  </div>

  <div class="field">
    <%= f.label :password %><br>
    <%= f.password_field :password,required: true %>
  </div>

  <div class="field ">
    <%= f.check_box :remember_me %>
    <%= f.label :remember_me %>
  </div>

  <div class="actions">
    <%= f.submit "Log in", class: "btn btn-sm", style: "background-color: #abd1c6; color: #001e1d" %>
  </div>
<% end %>

<%= link_to "Sign up", new_user_path %><br>

<%= link_to "Forgot your password?", new_password_path %>

</div>
</div>
</div>
